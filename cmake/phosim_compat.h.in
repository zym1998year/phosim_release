  // POSIX posix_memalign shim backed by _aligned_malloc. PhoSim never frees these
  // allocations (process-lifetime), so no _aligned_free pairing is required.
  static inline int phosim_posix_memalign(void **ptr, std::size_t alignment, std::size_t size) {
      void *p = _aligned_malloc(size, alignment);
      if (p == nullptr) return 12; // ENOMEM
