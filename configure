#!/bin/bash
# configure - CMake front-end shim
# Preserves the historical 'Welcome' message; delegates to cmake.

echo '-------------------------------'
echo 'Welcome to the Photon Simulator'
echo '-------------------------------'
echo ' '

echo 'PhoSim now uses CMake for the build. This script delegates to cmake.'
echo 'Type "make" (which wraps cmake) to complete the installation.'
echo ' '

echo 'Configuring with conda-forge / system cfitsio + fftw (recommended).'
echo 'For the legacy vendored build (Linux only), set PHOSIM_BUILD_VENDORED_DEPS=ON:'
echo '   cmake -B build -DPHOSIM_BUILD_VENDORED_DEPS=ON'
echo ' '

# Write minimal bin/setup compatibility shim
mkdir -p bin
cat > bin/setup <<'EOF'
# bin/setup - compatibility shim
# Modern PhoSim builds use CMake; this file exists for legacy scripts that
# source bin/setup expecting PYTHON to be defined.
export PYTHON="$(which python3 || which python)"
EOF

echo 'Configuration complete. Run "make" to build.'
