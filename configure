#!/bin/bash


echo '-------------------------------'
echo 'Welcome to the Photon Simulator'
echo '-------------------------------'
echo ' '

UNAME=`uname`
echo "Operating system: "${UNAME}

CCS=g++
CCP=g++
local='/usr'
if [ -d '/usr/local' ]; then
   local="/usr/local $local"
fi
if [ "$UNAME" == "Darwin" ];  then
    if [ -d '/sw' ]; then
        local="/sw ${local}"
    fi
fi
dir=`pwd`

echo "local: $local"

condor=`which condor_compile | grep -v not`
echo $condor
if [ "$condor" != "" ]; then
    echo ' '
    echo 'Would you like to use the condor compiler (y/n)?'
    read -n 1 choice
    if [ "$choice" == "y" ]; then
        CCP=(\"condor_compile g++\")
    fi
fi


echo ' '

cd bin
rm -f setup

echo 'Setting up python.'

pyt=`which python | grep -v not`
if [ "$pyt" == "" ]; then
    pyt=`which python3 | grep -v not`
fi
if [ "$pyt" == "" ]; then
   echo "Can't find python, please enter the path to python: "
   read pyt
fi

echo ${pyt} | awk '{print "export PYTHON=\""$1"\""}' >> setup
if [ -z "{$PYTHONPATH}" ]; then
    echo ${PYTHONPATH} | awk '{print "export PYTHONPATH=\""$1"\""}' >> setup
fi

cd ..

echo ' '

echo 'The photon simulator requires the installation of cfitsio and fftw3.'
echo 'If you use existing installations, they should be reasonably up to date to ensure compatibility.'
echo 'Would you like to have this script: (a) install these from source, (b) look for existing installations, or (c) specify the paths by hand? '
read -n 1 choice

if [ "$choice"  == "a" ]; then

cd source
rm -Rf cfitsio
tar xvf cfitsio-4.4.0.tar
cd cfitsio-4.4.0
./configure
make
make install
cd ..
rm -Rf cfitsio
mv cfitsio-4.4.0 cfitsio
rm -Rf fftw-3.3.10
tar xvf fftw-3.3.10.tar
cd fftw-3.3.10
./configure --prefix="$(pwd)" --disable-fortran
make
make install
cd ..
rm -Rf fftw
mv fftw-3.3.10 fftw
cd ..
cd bin

echo "export CCP=\""$CCP"\"" >> setup
echo "export CCS=\""$CCS"\"" >> setup
echo "export CFIODIR=\""$dir"/source/cfitsio/lib/\"" >> setup
echo "export CFIO_INC_DIR=\""$dir"/source/cfitsio/include/\"" >> setup
echo "export FFTW3_DIR=\""$dir"/source/fftw/lib/\"" >> setup
echo "export FFTW3_INC_DIR=\""$dir"/source/fftw/include/\"" >> setup

fi
if [ "$choice" == "b" ]; then

cd bin

echo "export CCP=\""$CCP"\"" >> setup
echo "export CCS=\""$CCS"\"" >> setup

echo 'Base directory: '$dir
echo 'Looking for cfitsio library:  libcfitsio.a'
# libcfitsio:
string=`find $dir $local -name "libcfitsio.a" 2>&1 | grep -v "ermission denied" 2>&1 | grep -v "file or directory" | tail -1 | sed -e "s/libcfitsio.a//"`
while [ "$string" = "" ]; do
  echo "Can't find libcfitsio.a, please enter the path to libcfitsio.a: "
  read dir
  string=`find $dir $local -name "libcfitsio.a" 2>&1 | grep -v "ermission denied" 2>&1 | grep -v "file or directory" | tail -1 | sed -e "s/libcfitsio.a//"`
done
echo $string | awk '{print "export CFIODIR=\""$0"\""}' >> setup

echo 'Looking for cfitsio header file:  fitsio2.h'
# fitsio2:
# fitsio2:
string=`find $dir $local -name "fitsio2.h" 2>&1 | grep -v "ermission denied" 2>&1 | grep -v "file or directory" | tail -1 | sed -e "s/fitsio2.h//"`
while [ "$string" = "" ]; do
  echo "Can't find fitsio2.h, please enter the path to fitsio.h: "
  read dir
  string=`find $dir $local -name "fitsio2.h" 2>&1 | grep -v "ermission denied" 2>&1 | grep -v "file or directory" | tail -1 | sed -e "s/fitsio2.h//"`
done
echo $string | awk '{print "export CFIO_INC_DIR=\""$0"\""}' >> setup

echo 'Looking for fftw library:  libfftw3.a'
# fftw3:
string=`find $dir $local -name "libfftw3.a" 2>&1 | grep -v "ermission denied" 2>&1 | grep -v "file or directory" | tail -1 | sed -e "s/libfftw3.a//"`
while [ "$string" = "" ]; do
  echo "Can't find libfftw3.a, please enter path to libfftw3.a: "
  read dir
  string=`find $dir $local -name "libfftw3.a" 2>&1 | grep -v "ermission denied" 2>&1 | grep -v "file or directory" | tail -1 | sed -e "s/libfftw3.a//"`
done
echo $string | awk '{print "export FFTW3_DIR=\""$0"\""}' >> setup

echo 'Looking for fftw header file:  fftw3.h'
# fftw3i:
string=`find $dir $local -name "fftw3.h" 2>&1 | grep -v "ermission denied" 2>&1 | grep -v "file or directory" | tail -1 | sed -e "s/fftw3.h//"`
while [ "$string" = "" ]; do
  echo "Can't find fftw3.h, please enter path to fftw3.h: "
  read dir
  string=`find $dir $local -name "fftw3.h" 2>&1 | grep -v "ermission denied" 2>&1 | grep -v "file or directory" | tail -1 | sed -e "s/fftw3.h//"`
done
echo $string | awk '{print "export FFTW3_INC_DIR=\""$0"\""}' >> setup



fi


if [ "$choice" == "c" ]; then

cd bin

echo "export CCP=\""$CCP"\"" >> setup
echo "export CCS=\""$CCS"\"" >> setup

echo "Please enter the path to libcfitsio.a: "
read dir
set string=`find $dir -name "libcfitsio.a" |& grep -v "ermission denied" | tail -1 | sed -e "s/libcfitsio.a//"`
echo $string | awk '{print "export CFIODIR=\""$0"\""}' >> setup

echo "Please enter the path to fitsio.h: "
read dir
set string=`find $dir -name "fitsio2.h" |& grep -v "ermission denied" | tail -1 | sed -e "s/fitsio2.h//"`
echo $string | awk '{print "export CFIO_INC_DIR=\""$0"\""}' >> setup

echo "Please enter the path to libfftw3.a: "
read dir
set string=`find $dir -name "libfftw3.a" |& grep -v "ermission denied" | tail -1 | sed -e "s/libfftw3.a//"`
echo $string | awk '{print "export FFTW3_DIR=\""$0"\""}' >> setup

echo "Please enter the path to fftw3.h: "
read dir
set string=`find $dir -name "fftw3.h" |& grep -v "ermission denied" | tail -1 | sed -e "s/fftw3.h//"`
echo $string | awk '{print "export FFTW3_INC_DIR=\""$0"\""}' >> setup

fi


echo ' '

. ./setup
if  [ -f $CFIO_INC_DIR/fitsio.h ]; then
    if  [ -f $FFTW3_INC_DIR/fftw3.h ]; then
        echo 'The Photon Simulator is now configured!'
        echo ' '
        echo 'Type "make" to complete the installation.'
    else
        echo 'Error:   fftw3 is not installed correctly.'
    fi
else
    if  [ -f $FFTW3_INC_DIR/fftw3.h ]; then
        echo 'Error:   cfitsio is not installed correctly.'
    else
        echo 'Error:   cfitsio is not installed correctly.'
        echo 'Error:   fftw3 is not installed correctly.'
    fi
fi

echo ' '
